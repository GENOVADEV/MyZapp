generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  email         String    @unique
  passwordHash  String
  otpCode       String?
  otpExpiry     DateTime?
  isVerified    Boolean   @default(false)
  activeSession String?
  role          String    @default("USER")
  botConfig     String?   @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("User")
}

model WhatsappSession {
  sessionId   String   @id
  sessionData String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("WhatsappSessions")
}

model BotVariable {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bot_variables")
}
