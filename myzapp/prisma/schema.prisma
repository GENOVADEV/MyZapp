generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  emailVerified DateTime?
  name          String?
  username      String?              @unique
  phone         String?              @unique
  image         String?
  password      String?
  language      String               @default("fr")
  theme         String               @default("light")
  timezone      String               @default("Europe/Paris")
  status        UserStatus           @default(ACTIVE)
  role          UserRole             @default(USER)
  plan          Plan                 @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  transaction  Transaction[]
  accounts      Account[]
  apiKeys       ApiKey[]
  appSessions   AppWhatsAppSession[]
  auditLogs     AuditLog[]
  devices       Device[]
  notifications Notification[]
  payments      Payment[]
  sessions      Session[]
  subscriptions Subscription[]

  @@index([email])
  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  deviceId     String?
  isActive     Boolean  @default(true)
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  device       Device?  @relation(fields: [deviceId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id         String     @id @default(cuid())
  userId     String
  deviceName String
  deviceType DeviceType
  isActive   Boolean    @default(true)
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions   Session[]

  @@unique([userId, deviceType])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               Plan
  status             SubscriptionStatus
  provider           PaymentProvider
  providerSubId      String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  subscriptionId    String?
  amount            Float
  currency          String          @default("EUR")
  status            PaymentStatus
  provider          PaymentProvider
  providerPaymentId String?         @unique
  createdAt         DateTime        @default(now())
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model AppWhatsAppSession {
  id        String @id
  sessionId String
  userId    String
  botPhone  String?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([botPhone])
  @@map("AppWhatsAppSessions")
}

model BotUsage {
  id           Int      @id @default(autoincrement())
  sessionId    String
  date         DateTime @db.Date
  commandCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sessionId, date])
  @@index([sessionId])
  @@map("bot_usages")
}

model Warn {
  id        String   @id @default(cuid())
  chat      String
  user      String
  reason    String?  @default("No reason provided")
  warnedBy  String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_warn")
}

model Filter {
  id            String   @id @default(cuid())
  trigger       String
  response      String
  jid           String?
  scope         String   @default("chat")
  enabled       Boolean  @default(true)
  caseSensitive Boolean  @default(false)
  exactMatch    Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("filter")
}

model AntilinkConfig {
  jid           String   @id
  mode          String   @default("delete")
  allowedLinks  String?
  blockedLinks  String?
  isWhitelist   Boolean  @default(true)
  enabled       Boolean  @default(true)
  customMessage String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("antilink_config")
}

model Welcome {
  id        String   @id @default(cuid())
  jid       String
  message   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("welcome")
}

model Goodbye {
  id        String   @id @default(cuid())
  jid       String
  message   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goodbye")
}

model Fake {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fake")
}

model AntiSpam {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("antispam")
}

model Pdm {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pdm")
}

model AntiDemote {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("antidemote")
}

model AntiPromote {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("antipromote")
}

model AntiBot {
  id        String   @id @default(cuid())
  jid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("antibot")
}

model antiwords {
  id        Int      @id @default(autoincrement())
  word      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jid       String?
}

model AntiDeleteCaches {
  messageId   String   @id @db.VarChar(255)
  chatJid     String   @db.VarChar(255)
  senderJid   String   @db.VarChar(255)
  fullContent Json     @db.Json
  timestamp   DateTime @db.Timestamptz(6)
  Chats       Chats    @relation(fields: [chatJid], references: [jid], onDelete: Cascade)
  Users       Users    @relation(fields: [senderJid], references: [jid], onDelete: Cascade)

  @@index([chatJid], map: "anti_delete_caches_chat_jid")
  @@index([messageId], map: "anti_delete_caches_message_id")
  @@index([timestamp], map: "anti_delete_caches_timestamp")
}

model AppUsers {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  plan      String?  @default("FREE") @db.VarChar(255)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model Chats {
  jid              String             @id @db.VarChar(255)
  type             enum_Chats_type
  name             String?            @db.VarChar(255)
  isActive         Boolean?           @default(true)
  createdAt        DateTime           @db.Timestamptz(6)
  updatedAt        DateTime           @db.Timestamptz(6)
  AntiDeleteCaches AntiDeleteCaches[]
  UserStats        UserStats[]

  @@index([isActive], map: "chats_is_active")
  @@index([jid], map: "chats_jid")
  @@index([type], map: "chats_type")
}

model Plugins {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  url       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model UserStats {
  id              Int       @id @default(autoincrement())
  userJid         String    @db.VarChar(255)
  chatJid         String    @db.VarChar(255)
  totalMessages   Int?      @default(0)
  textMessages    Int?      @default(0)
  imageMessages   Int?      @default(0)
  videoMessages   Int?      @default(0)
  audioMessages   Int?      @default(0)
  stickerMessages Int?      @default(0)
  otherMessages   Int?      @default(0)
  lastMessageAt   DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @db.Timestamptz(6)
  updatedAt       DateTime  @db.Timestamptz(6)
  Chats           Chats     @relation(fields: [chatJid], references: [jid], onDelete: Cascade)
  Users           Users     @relation(fields: [userJid], references: [jid], onDelete: Cascade)

  @@unique([userJid, chatJid], map: "user_stats_user_jid_chat_jid")
  @@index([chatJid], map: "user_stats_chat_jid")
  @@index([lastMessageAt], map: "user_stats_last_message_at")
  @@index([totalMessages], map: "user_stats_total_messages")
}

model Users {
  jid              String             @id @db.VarChar(255)
  name             String?            @db.VarChar(255)
  lastSeen         DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @db.Timestamptz(6)
  updatedAt        DateTime           @db.Timestamptz(6)
  AntiDeleteCaches AntiDeleteCaches[]
  UserStats        UserStats[]

  @@index([jid], map: "users_jid")
  @@index([lastSeen], map: "users_last_seen")
}

model WhatsappSessions {
  sessionId   String   @id @db.VarChar(255)
  sessionData String?
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @db.Timestamptz(6)
}

model warns {
  id        Int       @id @default(dbgenerated("nextval('_warns_id_seq'::regclass)"))
  chat      String    @db.VarChar(255)
  user      String    @db.VarChar(255)
  reason    String?   @default("No reason provided")
  warnedBy  String    @db.VarChar(255)
  timestamp DateTime? @db.Timestamptz(6)
  createdAt DateTime  @db.Timestamptz(6)
  updatedAt DateTime  @db.Timestamptz(6)

  @@map("_warns")
}

model antibots {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model antidemotes {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model antilink_configs {
  jid           String                     @id @db.VarChar(255)
  mode          enum_antilink_configs_mode @default(delete)
  allowedLinks  String?
  blockedLinks  String?
  isWhitelist   Boolean?                   @default(true)
  enabled       Boolean?                   @default(true)
  customMessage String?
  updatedBy     String?                    @db.VarChar(255)
  updatedAt     DateTime?                  @db.Timestamptz(6)
  createdAt     DateTime                   @db.Timestamptz(6)
}

model antilinks {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model antipromotes {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model antispams {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model automutes {
  id        Int      @id @default(autoincrement())
  chat      String   @db.VarChar(255)
  time      String   @db.VarChar(255)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model autounmutes {
  id        Int      @id @default(autoincrement())
  chat      String   @db.VarChar(255)
  time      String   @db.VarChar(255)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bot_variables {
  key       String   @id @db.VarChar(255)
  value     String?
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model fakes {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model filters {
  id            Int                 @id @default(autoincrement())
  trigger       String              @db.VarChar(255)
  response      String
  jid           String?             @db.VarChar(255)
  scope         enum_filters_scope? @default(chat)
  enabled       Boolean?            @default(true)
  caseSensitive Boolean?            @default(false)
  exactMatch    Boolean?            @default(false)
  createdBy     String              @db.VarChar(255)
  createdAt     DateTime            @db.Timestamptz(6)
  updatedAt     DateTime            @db.Timestamptz(6)
}

model goodbyes {
  id        Int      @id @default(autoincrement())
  jid       String   @db.VarChar(255)
  message   String
  enabled   Boolean? @default(true)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model pdms {
  id        Int      @id @default(autoincrement())
  jid       String
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model scheduled_messages {
  id           Int      @id @default(autoincrement())
  jid          String   @db.VarChar(255)
  message      String   @db.VarChar(2048)
  scheduleTime DateTime @db.Timestamptz(6)
  isSent       Boolean? @default(false)
  createdAt    DateTime @db.Timestamptz(6)
  updatedAt    DateTime @db.Timestamptz(6)
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  currency      String   // "EUR", "USD", "XAF"
  provider      String   // "STRIPE" ou "CAMPAY"
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  reference     String   @unique // L'ID de la transaction chez Stripe/Campay
  planPurchased String   // "YOUNG", "AGENT", "BUSINESS"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
}

model stickcmds {
  id        Int      @id @default(autoincrement())
  command   String   @db.VarChar(1000)
  file      String   @db.VarChar(1000)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

model welcomes {
  id        Int      @id @default(autoincrement())
  jid       String   @db.VarChar(255)
  message   String
  enabled   Boolean? @default(true)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Plan {
  FREE
  YOUNG
  AGENT
  BUSINESS
  PRO
}

enum DeviceType {
  WEB
  MOBILE
  DESKTOP
  TABLET
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  CREDIT_CARD
}

enum enum_Chats_type {
  private
  group
}

enum enum_antilink_configs_mode {
  warn
  kick
  delete
}

enum enum_filters_scope {
  chat
  global
  dm
  group
}
