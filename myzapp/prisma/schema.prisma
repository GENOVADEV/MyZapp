generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  emailVerified       DateTime?
  name                String?
  username            String?            @unique
  phone               String?            @unique
  phoneVerified       DateTime?
  image               String?
  password            String?
  language            String             @default("fr")
  theme               String             @default("light")
  timezone            String             @default("Europe/Paris")
  twoFactorEnabled    Boolean            @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  status              UserStatus         @default(ACTIVE)
  role                UserRole           @default(USER)
  plan                Plan               @default(FREE)
  planExpiresAt       DateTime?
  trialEndsAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  lastSyncAt          DateTime?
  accounts            Account[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  bots                Bot[]
  initiatedCalls      Call[]             @relation("CallInitiator")
  contactOf           Contact[]          @relation("ContactUser")
  contacts            Contact[]          @relation("UserContacts")
  conversations       Conversation[]
  devices             Device[]
  folders             Folder[]
  ownedGroups         Group[]            @relation("GroupOwner")
  groups              GroupMember[]
  mediaFiles          MediaFile[]
  messages            Message[]
  notifications       Notification[]
  payments            Payment[]
  polls               Poll[]
  pollVotes           PollVote[]
  reactions           Reaction[]
  scheduledMessages   ScheduledMessage[]
  sessions            Session[]
  subscriptions       Subscription[]
  voiceNotes          VoiceNote[]
  calls               Call[]             @relation("CallParticipants")

  whatsappConnected Boolean @default(false)
  whatsappId String?
  lastWhatsappSync DateTime?

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([plan])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  deviceId     String?
  device       Device?  @relation(fields: [deviceId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model VerificationToken {
  identifier String
  token      String    @unique
  type       TokenType @default(EMAIL_VERIFICATION)
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

model Device {
  id          String     @id @default(cuid())
  userId      String
  deviceName  String
  deviceType  DeviceType
  deviceToken String?
  platform    String?
  osVersion   String?
  appVersion  String?
  isActive    Boolean    @default(true)
  lastSeenAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deviceToken])
  @@unique([userId, deviceType])
}

model Conversation {
  id                String           @id @default(cuid())
  userId            String
  type              ConversationType
  whatsappId        String
  name              String?
  description       String?
  avatar            String?
  contactId         String?
  groupId           String?
  isPinned          Boolean          @default(false)
  isMuted           Boolean          @default(false)
  mutedUntil        DateTime?
  isArchived        Boolean          @default(false)
  isBlocked         Boolean          @default(false)
  isLocked          Boolean          @default(false)
  lockPin           String?
  ephemeralEnabled  Boolean          @default(false)
  ephemeralDuration Int?
  folderId          String?
  lastMessageAt     DateTime?
  lastReadAt        DateTime?
  unreadCount       Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  contact           Contact?         @relation(fields: [contactId], references: [id])
  folder            Folder?          @relation(fields: [folderId], references: [id])
  group             Group?           @relation(fields: [groupId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts            Draft[]
  messages          Message[]

  @@unique([userId, contactId])
  @@unique([userId, groupId])
  @@unique([userId, whatsappId])
  @@index([userId])
  @@index([contactId])
  @@index([groupId])
  @@index([folderId])
  @@index([lastMessageAt])
  @@index([whatsappId])
  @@index([userId, lastMessageAt])
}

model Message {
  id                 String        @id @default(cuid())
  conversationId     String
  senderId           String
  type               MessageType
  content            String?
  mediaFileId        String?
  voiceNoteId        String?
  replyToId          String?
  forwardedFromId    String?
  forwardCount       Int           @default(0)
  status             MessageStatus @default(SENT)
  deliveredAt        DateTime?
  readAt             DateTime?
  isEdited           Boolean       @default(false)
  editedAt           DateTime?
  originalContent    String?
  editHistory        Json?
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  deletedFor         String[]
  isPinned           Boolean       @default(false)
  isEphemeral        Boolean       @default(false)
  ephemeralExpiresAt DateTime?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  expiresAt          DateTime?
  conversation       Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  forwardedFrom      Message?      @relation("MessageForwards", fields: [forwardedFromId], references: [id])
  forwards           Message[]     @relation("MessageForwards")
  mediaFile          MediaFile?    @relation(fields: [mediaFileId], references: [id])
  replyTo            Message?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies            Message[]     @relation("MessageReplies")
  sender             User          @relation(fields: [senderId], references: [id])
  voiceNote          VoiceNote?    @relation(fields: [voiceNoteId], references: [id])
  reactions          Reaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([status])
  @@index([ephemeralExpiresAt])
  @@index([expiresAt])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ScheduledMessage {
  id             String                 @id @default(cuid())
  userId         String
  conversationId String?                @unique
  recipientType  RecipientType
  recipientId    String
  type           MessageType
  content        String?
  mediaFileId    String?
  scheduledFor   DateTime
  timezone       String                 @default("Europe/Paris")
  status         ScheduledMessageStatus @default(PENDING)
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?
  repeatType     RepeatType             @default(ONCE)
  repeatUntil    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  mediaFile      MediaFile?             @relation(fields: [mediaFileId], references: [id])
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
}

model Draft {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  content        String?
  mediaFiles     String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Contact {
  id            String         @id @default(cuid())
  userId        String
  contactUserId String?
  name          String
  phone         String?
  email         String?
  avatar        String?
  bio           String?
  isFavorite    Boolean        @default(false)
  isBlocked     Boolean        @default(false)
  notes         String?
  customFields  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contactUser   User?          @relation("ContactUser", fields: [contactUserId], references: [id])
  user          User           @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([userId, phone])
  @@unique([userId, contactUserId])
  @@index([userId])
  @@index([contactUserId])
}

model Group {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  avatar              String?
  ownerId             String
  maxMembers          Int            @default(256)
  isPublic            Boolean        @default(false)
  inviteLink          String?        @unique
  onlyAdminsCanPost   Boolean        @default(false)
  onlyAdminsCanEdit   Boolean        @default(false)
  membersCanAddOthers Boolean        @default(true)
  ephemeralEnabled    Boolean        @default(false)
  ephemeralDuration   Int?
  moderationEnabled   Boolean        @default(false)
  bannedWords         String[]
  autoDeleteSpam      Boolean        @default(false)
  totalMessages       Int            @default(0)
  activeMembers       Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  conversations       Conversation[]
  owner               User           @relation("GroupOwner", fields: [ownerId], references: [id])
  members             GroupMember[]
  polls               Poll[]

  @@index([ownerId])
  @@index([inviteLink])
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  role       GroupRole @default(MEMBER)
  canPost    Boolean   @default(true)
  canInvite  Boolean   @default(true)
  isMuted    Boolean   @default(false)
  mutedUntil DateTime?
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model MediaFile {
  id                String             @id @default(cuid())
  userId            String
  fileName          String
  fileSize          Int
  mimeType          String
  url               String
  thumbnailUrl      String?
  width             Int?
  height            Int?
  duration          Int?
  type              MediaType
  isCompressed      Boolean            @default(false)
  originalUrl       String?
  storageProvider   String             @default("s3")
  storagePath       String
  createdAt         DateTime           @default(now())
  expiresAt         DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model VoiceNote {
  id            String    @id @default(cuid())
  userId        String
  url           String
  duration      Int
  waveform      Json?
  transcription String?
  transcribedAt DateTime?
  language      String?
  fileSize      Int
  mimeType      String    @default("audio/ogg")
  createdAt     DateTime  @default(now())
  messages      Message[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Poll {
  id            String     @id @default(cuid())
  groupId       String?
  createdBy     String
  question      String
  options       Json
  allowMultiple Boolean    @default(false)
  isAnonymous   Boolean    @default(false)
  expiresAt     DateTime?
  isClosed      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  creator       User       @relation(fields: [createdBy], references: [id])
  group         Group?     @relation(fields: [groupId], references: [id])
  votes         PollVote[]

  @@index([groupId])
  @@index([createdBy])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Call {
  id             String       @id @default(cuid())
  initiatorId    String
  type           CallType
  status         CallStatus   @default(RINGING)
  participantIds String[]
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  isRecorded     Boolean      @default(false)
  recordingUrl   String?
  quality        CallQuality?
  createdAt      DateTime     @default(now())
  initiator      User         @relation("CallInitiator", fields: [initiatorId], references: [id])
  participants   User[]       @relation("CallParticipants")

  @@index([initiatorId])
  @@index([status])
  @@index([createdAt])
}

model Folder {
  id            String         @id @default(cuid())
  userId        String
  name          String
  icon          String?
  color         String?
  position      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([position])
}

model Bot {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  avatar          String?
  type            BotType
  config          Json
  triggers        Json
  isActive        Boolean   @default(true)
  totalMessages   Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               Plan
  status             SubscriptionStatus
  provider           PaymentProvider
  providerSubId      String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  subscriptionId    String?
  amount            Float
  currency          String          @default("EUR")
  status            PaymentStatus
  provider          PaymentProvider
  providerPaymentId String?         @unique
  metadata          Json?
  createdAt         DateTime        @default(now())
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique
  scopes     String[]
  rateLimit  Int       @default(1000)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Plan {
  FREE
  YOUNG
  AGENT
  BUSINESS
  PRO
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
  PHONE_VERIFICATION
}

enum DeviceType {
  WEB
  MOBILE
  DESKTOP
  TABLET
}

enum ConversationType {
  DIRECT
  GROUP
  SELF
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  POLL
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  VOICE_NOTE
}

enum RecipientType {
  CONTACT
  GROUP
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum RepeatType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum GroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
}

enum CallQuality {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum BotType {
  AUTO_REPLY
  WELCOME_MESSAGE
  SCHEDULED
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  CREDIT_CARD
}

enum NotificationType {
  NEW_MESSAGE
  MENTION
  CALL_MISSED
  GROUP_INVITE
  SYSTEM
  PAYMENT
  SECURITY
}

enum NotificationStatus {
  UNREAD
  READ
}
